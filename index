<script>
function scrollToDonate(){
  document.getElementById("donate").scrollIntoView({behavior:"smooth"});
}

let hindi=false;
function toggleLang(){
  hindi=!hindi;
  document.getElementById("heroTitle").innerText =
    hindi ? "दान से जीवन बचाइए" : "Give Life Through Donation";
  document.getElementById("heroText").innerText =
    hindi ? "अंग और रक्त दान द्वारा जीवन बचाना" : "Saving lives by promoting organ and blood donation.";
  document.getElementById("aboutTitle").innerText =
    hindi ? "हमारे बारे में" : "About Us";
  document.getElementById("aboutText").innerText =
    hindi ? "पटेल जीवनदान फाउंडेशन समाज में अंग और रक्त दान के प्रति जागरूकता फैलाता है।"
          : "Patel Jivandaan Foundation works to spread awareness about organ and blood donation.";
}
</script>

