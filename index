<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Patel Jivandaan Foundation</title>

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --primary:#b71c1c;
  --secondary:#ffca28;
  --dark:#111;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Poppins',sans-serif;
}

body{
  background:#f9f9f9;
  color:#333;
}

/* HEADER */
header{
  background:var(--primary);
  padding:15px 30px;
  position:sticky;
  top:0;
  z-index:999;
}
nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
}
nav h1{
  color:#fff;
  font-size:24px;
}
nav ul{
  display:flex;
  list-style:none;
}
nav ul li{
  margin-left:18px;
}
nav ul li a{
  color:#fff;
  text-decoration:none;
  font-weight:500;
}

/* LANGUAGE BUTTON */
.lang-btn{
  background:var(--secondary);
  border:none;
  padding:6px 12px;
  border-radius:4px;
  cursor:pointer;
  font-weight:600;
}

/* HERO */
.hero{
  height:90vh;
  background:
  linear-gradient(rgba(0,0,0,.6),rgba(0,0,0,.6)),
  url('https://images.unsplash.com/photo-1509099836639-18ba1795216d');
  background-size:cover;
  background-position:center;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  text-align:center;
  padding:20px;
}
.hero h2{font-size:44px}
.hero p{margin:15px 0}
.hero button{
  background:var(--secondary);
  border:none;
  padding:12px 28px;
  font-size:16px;
  border-radius:6px;
  cursor:pointer;
}

/* SECTIONS */
section{
  padding:60px 40px;
  text-align:center;
}
section h2{
  color:var(--primary);
  margin-bottom:20px;
}

/* ABOUT */
.about{
  display:flex;
  flex-wrap:wrap;
  gap:30px;
  align-items:center;
  justify-content:center;
}
.about img{
  max-width:420px;
  width:100%;
  border-radius:10px;
}
.about div{
  max-width:500px;
  text-align:left;
}

/* SERVICES */
.services{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:25px;
}
.card{
  background:#fff;
  border-radius:8px;
  overflow:hidden;
  box-shadow:0 4px 10px rgba(0,0,0,.1);
}
.card img{
  width:100%;
  height:180px;
  object-fit:cover;
}
.card div{
  padding:20px;
}

/* GALLERY */
.gallery{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:15px;
}
.gallery img{
  width:100%;
  height:200px;
  object-fit:cover;
  border-radius:8px;
}

/* DONATE */
.donate{
  background:var(--primary);
  color:#fff;
}
.donate h2{color:#fff}
.donate button{
  background:var(--secondary);
  border:none;
  padding:12px 30px;
  border-radius:6px;
  font-size:16px;
  margin-top:15px;
  cursor:pointer;
}

/* CONTACT */
.contact p{
  margin:8px 0;
  font-size:16px;
}

/* FOOTER */
footer{
  background:var(--dark);
  color:#aaa;
  padding:15px;
  text-align:center;
}

/* WHATSAPP */
.whatsapp{
  position:fixed;
  bottom:20px;
  right:20px;
  background:#25D366;
  color:#fff;
  padding:14px 16px;
  border-radius:50%;
  font-size:22px;
  text-decoration:none;
}

/* MOBILE FIX */
@media(max-width:768px){
  nav{
    flex-direction:column;
  }
  nav ul{
    flex-direction:column;
    align-items:center;
    margin-top:10px;
  }
  nav ul li{
    margin:10px 0;
  }
  .hero h2{
    font-size:30px;
  }
  section{
    padding:40px 20px;
  }
  .about div{
    text-align:center;
  }
}
</style>
</head>

<body>

